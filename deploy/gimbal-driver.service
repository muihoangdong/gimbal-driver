[Unit]
Description=Gimbal Driver service
After=network.target rs3mini-bridge.service

[Service]
User=pi
WorkingDirectory=/home/pi/gimbal-driver
ExecStart=/home/pi/gimbal-driver/build/gimbal-driver --config /home/pi/gimbal-driver/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
